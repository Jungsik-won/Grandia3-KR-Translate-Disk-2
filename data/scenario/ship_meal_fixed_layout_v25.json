  "translation_templates": [
    {
      "id_suffix": "_00740000_0036",
      "kr_text": "저기, 울 말이야\n어떻게 시바와\n친해진 거야?"
    },
    {
      "id_suffix": "_R00740000_O42_0002",
      "kr_text": "생각해 본 적 없어.\n태어날 때부터\n계속 함께였으니까."
    },
    {
      "id_suffix": "_00740000_0037",
      "kr_text": "늘 함께였어?\n아버지와 아들 같네!"
    },
    {
      "id_suffix": "_R00740000_O42_0003",
      "kr_text": "그 이상이야!\n몸의 일부 같은 거지.\n나와 시바는."
    },
    {
      "id_suffix": "_00740000_0038",
      "kr_text": "몸의 일부라……\n그건 비행기 조종사에게도\n이상적인 일이겠지."
    }
  ],
