[
  {
    "start": 12.10,
    "end": 16.30,
    "speaker": "유키",
    "jp": "ん？ 誰だ？ こんな時間に……。",
    "ko": "응? 누구지?\n이런 시간에……"
  },
  {
    "start": 18.85,
    "end": 20.25,
    "speaker": "유키",
    "jp": "あ、アルフィナ！",
    "ko": "아, 알피나!"
  },
  {
    "start": 20.55,
    "end": 22.70,
    "speaker": "알피나",
    "jp": "え？ 来ちゃった。",
    "ko": "응. 와 버렸어."
  },
  {
    "start": 23.00,
    "end": 24.90,
    "speaker": "유키",
    "jp": "き、来ちゃったって……。",
    "ko": "와, 와 버렸다니……"
  },
  {
    "start": 25.70,
    "end": 27.20,
    "speaker": "유키",
    "jp": "とにかく、入って。",
    "ko": "아무튼 들어와."
  },
  {
    "start": 32.05,
    "end": 33.45,
    "speaker": "알피나",
    "jp": "懐かしい！",
    "ko": "그립다!"
  },
  {
    "start": 33.65,
    "end": 35.25,
    "speaker": "알피나",
    "jp": "ちっとも変わってない！",
    "ko": "조금도 변하지 않았어!"
  },
  {
    "start": 35.70,
    "end": 36.15,
    "speaker": "유키",
    "jp": "え？",
    "ko": "응?"
  },
  {
    "start": 36.80,
    "end": 41.90,
    "speaker": "알피나",
    "jp": "ここね、まだ小さかった頃、私が使ってた部屋なの。",
    "ko": "여긴 내가 아주 어렸을 때\n쓰던 방이야."
  },
  {
    "start": 43.60,
    "end": 44.55,
    "speaker": "유키",
    "jp": "そっか。",
    "ko": "그렇구나."
  },
  {
    "start": 45.00,
    "end": 47.75,
    "speaker": "유키",
    "jp": "アルフィナがいたんだ、ここに。",
    "ko": "알피나가 여기서 살았구나."
  },
  {
    "start": 51.70,
    "end": 56.20,
    "speaker": "알피나",
    "jp": "子供の頃は、この部屋がとっても広く思えたの。",
    "ko": "어릴 적엔 이 방이\n정말 넓게 느껴졌어."
  },
  {
    "start": 56.75,
    "end": 59.55,
    "speaker": "알피나",
    "jp": "まるで世界に私だけがいるみたいだった。",
    "ko": "마치 세상에 나 혼자만\n있는 것 같았지."
  },
  {
    "start": 59.85,
    "end": 61.05,
    "speaker": "유키",
    "jp": "一人ぼっちだったの？",
    "ko": "혼자였던 거야?"
  },
  {
    "start": 62.20,
    "end": 62.75,
    "speaker": "알피나",
    "jp": "ううん。",
    "ko": "아니."
  },
  {
    "start": 70.05,
    "end": 73.35,
    "speaker": "알피나",
    "jp": "あ、あった！ 来て、ユウキ！",
    "ko": "아, 있다! 이리 와, 유키!"
  },
  {
    "start": 73.35,
    "end": 74.20,
    "speaker": "유키",
    "jp": "え？",
    "ko": "응?"
  },
  {
    "start": 78.25,
    "end": 84.40,
    "speaker": "알피나",
    "jp": "ほら！ こっちが私のつもり。",
    "ko": "봐! 이쪽이 나를 그린 거야."
  },
  {
    "start": 85.55,
    "end": 87.25,
    "speaker": "유키",
    "jp": "アルフィナが描いたんだ？",
    "ko": "알피나가 그린 거야?"
  },
  {
    "start": 87.75,
    "end": 88.95,
    "speaker": "알피나",
    "jp": "うん。",
    "ko": "응."
  },
  {
    "start": 89.50,
    "end": 92.75,
    "speaker": "유키",
    "jp": "じゃあ、隣にいるのはアルフィナの……。",
    "ko": "그럼 옆에 있는 사람은\n알피나의……"
  },
  {
    "start": 93.10,
    "end": 96.50,
    "speaker": "알피나",
    "jp": "うん。兄さんなの。",
    "ko": "응. 오빠야."
  },
  {
    "start": 103.80,
    "end": 109.10,
    "speaker": "알피나",
    "jp": "12年前のあの日、ここから儀式を見てたの。",
    "ko": "12년 전 그날, 여기서\n의식을 지켜봤어."
  }
]
