  {"start": 75.400, "end": 82.000, "speaker": "헥트", "jp": "そして、ここで見たことはすべて忘れるのです。", "ko": "그리고 여기서 본 것은 모두 잊으세요."},
  {"start": 82.800, "end": 87.100, "speaker": "헥트", "jp": "二度と来ることのないように。", "ko": "두 번 다시 오지 않도록."},
  {"start": 99.800, "end": 102.800, "speaker": "알피나", "jp": "一緒に行きましょう。あなたも。", "ko": "같이 가요. 당신도."},
  {"start": 104.600, "end": 106.200, "speaker": "알피나", "jp": "あ……冷たい。", "ko": "아…… 차가워."},
