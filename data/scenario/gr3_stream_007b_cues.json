[
  {"start": 9.800, "end": 11.900, "speaker": "유키", "jp": "人だ！ 人がいるんだ！", "ko": "사람이다! 사람이 있어!"},
  {"start": 12.000, "end": 12.600, "speaker": "알피나", "jp": "うん！", "ko": "응!"},
  {"start": 41.800, "end": 43.000, "speaker": "헥트", "jp": "誰？", "ko": "누구죠?"},
  {"start": 43.700, "end": 50.900, "speaker": "유키", "jp": "き、君は……どうしてこんなところに……。", "ko": "너는…… 어째서 이런 곳에……."},
  {"start": 51.000, "end": 55.800, "speaker": "헥트", "jp": "絆を……断ち切るため……。", "ko": "인연을…… 끊어 내기 위해……."},
  {"start": 58.700, "end": 63.500, "speaker": "헥트", "jp": "世界の記憶から消えてしまうべきなのです。", "ko": "세상의 기억에서 사라져야 합니다."},
  {"start": 65.200, "end": 67.200, "speaker": "헥트", "jp": "このバース界だけが。", "ko": "이 버스계만이."},
