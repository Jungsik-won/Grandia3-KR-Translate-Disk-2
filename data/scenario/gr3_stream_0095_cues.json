[
  {"start": 9.100, "end": 9.700, "speaker": "울", "jp": "ん？", "ko": "응?"},
  {"start": 10.960, "end": 13.100, "speaker": "울", "jp": "おかしい。ガードがいない。", "ko": "이상해. 보초가 없어."},
  {"start": 14.680, "end": 15.680, "speaker": "알피나", "jp": "どうしたの？", "ko": "왜 그래?"},
  {"start": 17.500, "end": 18.860, "speaker": "울", "jp": "静かすぎる！", "ko": "너무 조용해!"},
  {"start": 24.920, "end": 25.500, "speaker": "울", "jp": "何だ？", "ko": "뭐지?"},
  {"start": 35.820, "end": 36.500, "speaker": "울", "jp": "敵じゃない！", "ko": "적이 아니야!"},
  {"start": 36.960, "end": 38.100, "speaker": "울", "jp": "飛竜の民のウルだ！", "ko": "난 비룡족 울이야!"},
  {"start": 38.380, "end": 40.200, "speaker": "울", "jp": "飛竜王ドラクに会いに来たんだ！", "ko": "비룡왕 드라크를 만나러 왔어!"},
  {"start": 51.820, "end": 56.240, "speaker": "비룡족 수호자", "jp": "この地を侵す者は、何人たりとも許さぬ！", "ko": "이 땅을 침범하는 자는\n누구든 용서하지 않는다!"},
  {"start": 57.600, "end": 58.620, "speaker": "울", "jp": "ま、待ってくれ！", "ko": "자, 잠깐만!"},
  {"start": 59.040, "end": 62.240, "speaker": "울", "jp": "オイラ、コミュートを案内してきたんだ！信じてくれよ！", "ko": "내가 커뮤트를 안내해 왔어!\n믿어 줘!"},
  {"start": 62.660, "end": 66.460, "speaker": "비룡족 수호자", "jp": "このような形でコミュートが来るとは知らされておらん！", "ko": "커뮤트가 이런 식으로 온다는\n말은 듣지 못했다!"},
  {"start": 66.440, "end": 71.320, "speaker": "비룡족 수호자", "jp": "ウル、谷を抜けたお前の言葉など、誰が信じるか！", "ko": "울, 계곡을 떠난 네 말을\n누가 믿겠느냐!"},
  {"start": 82.180, "end": 84.300, "speaker": "울", "jp": "くそ！逃げるぞ、ユウキ！", "ko": "젠장! 도망가자, 유키!"},
  {"start": 93.940, "end": 97.600, "speaker": "울", "jp": "シバ！構うな！下だ！雲に潜れ！", "ko": "시바! 상대하지 마! 아래로!\n구름 속으로 들어가!"},
  {"start": 98.780, "end": 99.300, "speaker": "유키", "jp": "おい！", "ko": "야!"}
]
