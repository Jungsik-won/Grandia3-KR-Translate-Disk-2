[
  {"start": 10.750, "end": 12.000, "speaker": "알피나", "jp": "ひどい……！", "ko": "끔찍해……!"},
  {"start": 12.250, "end": 14.700, "speaker": "유키", "jp": "これは、バース界の……。", "ko": "이건… 버스계의 모습……?"},
  {"start": 20.500, "end": 23.100, "speaker": "듄켈", "jp": "そう、ゾーンの力だ。", "ko": "그래, 존의 힘이다."},
  {"start": 23.650, "end": 24.700, "speaker": "알피나", "jp": "デュンケル！", "ko": "듄켈!"},
  {"start": 25.550, "end": 28.300, "speaker": "듄켈", "jp": "これこそ、お前が選んだ結果だぞ、アルフィナ。", "ko": "이것이 네가 선택한 결과다, 알피나."},
  {"start": 31.200, "end": 32.300, "speaker": "알피나", "jp": "そ、そんな……。", "ko": "그, 그럴 수가……."},
  {"start": 34.450, "end": 38.050, "speaker": "유키", "jp": "お前、一体何者だ！ 何をしている？", "ko": "너, 대체 정체가 뭐야?!\n무슨 짓을 하는 거지?!"},
  {"start": 38.850, "end": 41.450, "speaker": "듄켈", "jp": "これ以上エメリウスに関わるな。", "ko": "더 이상 에메리우스와 엮이지 마라."},
  {"start": 42.050, "end": 44.200, "speaker": "듄켈", "jp": "奴は人の運命を狂わせる。", "ko": "그자는 사람의 운명을 망가뜨린다."},
  {"start": 44.650, "end": 48.250, "speaker": "듄켈", "jp": "いずれ、お前も俺のようになる。", "ko": "언젠가 너도 나처럼 될 거다."},
  {"start": 48.750, "end": 52.050, "speaker": "유키", "jp": "狂わせているのはお前じゃないのか？", "ko": "운명을 망가뜨리는 건 네 쪽 아니야?!"},
  {"start": 52.600, "end": 55.700, "speaker": "듄켈", "jp": "グリフが殺されたと各地の聖獣に伝えるがいい。", "ko": "그리프가 살해당했다고\n각지의 성수들에게 전해라."},
  {"start": 56.050, "end": 57.800, "speaker": "유키", "jp": "待て、デュンケル！", "ko": "기다려, 듄켈!"}
]
