[
  {"start": 8.88, "end": 10.42, "speaker": "유키", "jp": "あ、入るよ", "ko": "아, 들어갈게."},
  {"start": 26.84, "end": 29.44, "speaker": "알피나", "jp": "とっても素敵な香り", "ko": "정말 좋은 향기…"},
  {"start": 30.38, "end": 32.94, "speaker": "유키", "jp": "ああ、ハーブだよ", "ko": "아, 허브야."},
  {"start": 34.54, "end": 35.40, "speaker": "알피나", "jp": "ん？", "ko": "응?"},
  {"start": 35.82, "end": 38.90, "speaker": "유키", "jp": "ああ、これはカモミール", "ko": "아, 이건 캐모마일이야."},
  {"start": 39.84, "end": 41.94, "speaker": "알피나", "jp": "夕べは助けてくれてありがとう", "ko": "어젯밤에는 구해 줘서 고마워요."},
  {"start": 42.20, "end": 44.26, "speaker": "알피나", "jp": "私、アルフィナです", "ko": "저는 알피나예요."},
  {"start": 44.82, "end": 46.66, "speaker": "유키", "jp": "ああ、お、俺は", "ko": "아, 나… 나는…"},
  {"start": 46.68, "end": 48.36, "speaker": "알피나", "jp": "ユウキでしょ？", "ko": "유키 맞죠?"},
  {"start": 48.60, "end": 50.92, "speaker": "알피나", "jp": "ミランダさんが教えてくれたわ", "ko": "미란다 씨가 알려주셨어요."},
  {"start": 52.54, "end": 54.00, "speaker": "알피나", "jp": "よいしょ", "ko": "읏차…"},
  {"start": 55.32, "end": 56.56, "speaker": "알피나", "jp": "うーん", "ko": "앗…!"},
  {"start": 60.58, "end": 62.22, "speaker": "미란다", "jp": "何、今の声？", "ko": "뭐야, 방금 그 소리는?"},
  {"start": 70.14, "end": 72.02, "speaker": "미란다", "jp": "何やってんの、あんたたち？", "ko": "너희들, 뭐 하는 거야?"},
  {"start": 72.02, "end": 73.72, "speaker": "유키", "jp": "べ、別に？", "ko": "벼, 별거 아닌데?"},
  {"start": 74.64, "end": 76.04, "speaker": "미란다", "jp": "まあ、いいわ", "ko": "뭐, 됐어."},
  {"start": 78.12, "end": 80.30, "speaker": "미란다", "jp": "足、見せてごらん", "ko": "다리 좀 보여 줘."},
  {"start": 82.36, "end": 83.72, "speaker": "미란다", "jp": "さて", "ko": "자…"},
  {"start": 84.10, "end": 84.90, "speaker": "알피나", "jp": "うん", "ko": "읏…"},
  {"start": 88.18, "end": 91.70, "speaker": "미란다", "jp": "ねえ、よかったら教えてくれる？", "ko": "있잖아, 괜찮다면 말해 줄래?"},
  {"start": 92.86, "end": 95.26, "speaker": "미란다", "jp": "どうしてあの連中に追われていたの？", "ko": "왜 그 녀석들에게\n쫓기고 있었던 거야?"},
  {"start": 97.38, "end": 101.86, "speaker": "알피나", "jp": "私、アークリフへ帰りたかっただけなんです", "ko": "저는… 아크리프로\n돌아가고 싶었을 뿐이에요."},
  {"start": 102.36, "end": 107.94, "speaker": "유키", "jp": "アークリフって大陸の街だろ？ あの、大神殿で有名な", "ko": "아크리프라면 대륙에 있는 도시지?\n그 대신전으로 유명한 곳."},
  {"start": 108.14, "end": 108.94, "speaker": "알피나", "jp": "うん", "ko": "네."},
  {"start": 109.68, "end": 111.28, "speaker": "유키", "jp": "心当たりはないの？", "ko": "짐작 가는 데는 없어?"},
  {"start": 111.50, "end": 112.50, "speaker": "알피나", "jp": "全然", "ko": "전혀요."},
  {"start": 114.34, "end": 118.94, "speaker": "알피나", "jp": "わからない。みんな知らない人たちだった", "ko": "모르겠어요.\n모두 처음 보는 사람들이었어요."},
  {"start": 118.96, "end": 120.86, "speaker": "유키", "jp": "あの、黒いやつも？", "ko": "그 검은 옷을 입은 녀석도?"},
  {"start": 121.10, "end": 125.36, "speaker": "알피나", "jp": "あ、いいえ。あの人は…", "ko": "아, 아니요. 그 사람은…"},
  {"start": 127.24, "end": 129.38, "speaker": "미란다", "jp": "気持ちはわかるけどさ", "ko": "마음은 알겠지만 말이야."},
  {"start": 129.92, "end": 131.46, "speaker": "미란다", "jp": "こんなに無理して", "ko": "이렇게 무리하다가"},
  {"start": 131.46, "end": 134.68, "speaker": "미란다", "jp": "もし痣でも残ったらどうするの？", "ko": "흉터라도 남으면\n어쩌려고 그래?"},
  {"start": 136.60, "end": 137.78, "speaker": "미란다", "jp": "よいしょ、はい", "ko": "영차… 됐다."},
  {"start": 142.26, "end": 145.12, "speaker": "미란다", "jp": "いいわ。何も聞かずに送ってってあげる", "ko": "좋아. 아무것도 묻지 않고\n데려다줄게."},
  {"start": 145.28, "end": 145.90, "speaker": "알피나", "jp": "え？", "ko": "네?"},
  {"start": 146.06, "end": 148.78, "speaker": "미란다", "jp": "途中のメンディの港まででよかったらね", "ko": "도중에 있는 멘디 항구까지만이라도\n괜찮다면 말이야."},
  {"start": 149.18, "end": 152.20, "speaker": "알피나", "jp": "そんな、そこまでお世話にはなれません", "ko": "그렇게까지 신세 질 수는 없어요."},
  {"start": 153.00, "end": 154.84, "speaker": "미란다", "jp": "あんたはどうなの、ユウキ", "ko": "넌 어때, 유키?"},
  {"start": 156.60, "end": 158.48, "speaker": "유키", "jp": "ああ、俺も行くよ", "ko": "응, 나도 갈게."},
  {"start": 158.60, "end": 159.98, "speaker": "미란다", "jp": "よし、決まり", "ko": "좋아, 결정!"},
  {"start": 160.26, "end": 162.62, "speaker": "미란다", "jp": "じゃあ、二、三日のうちに出発ね", "ko": "그럼 이삼일 안에 출발하자."},
  {"start": 163.54, "end": 165.82, "speaker": "알피나", "jp": "ありがとう、ミランダさん", "ko": "고마워요, 미란다 씨."},
  {"start": 166.32, "end": 168.24, "speaker": "알피나", "jp": "ありがとう、ユウキ", "ko": "고마워요, 유키."},
  {"start": 171.42, "end": 173.58, "speaker": "글래디스", "jp": "ミランダー！", "ko": "미란다!"},
  {"start": 173.94, "end": 175.20, "speaker": "글래디스", "jp": "助けておくれよ！", "ko": "도와줘!"},
  {"start": 175.20, "end": 175.78, "speaker": "미란다", "jp": "あの声は…", "ko": "저 목소리는…"},
  {"start": 175.78, "end": 177.54, "speaker": "글래디스", "jp": "ミランダー！", "ko": "미란다!"},
  {"start": 177.74, "end": 178.78, "speaker": "미란다", "jp": "ちょっと見てくる", "ko": "잠깐 보고 올게."},
  {"start": 178.78, "end": 180.86, "speaker": "유키", "jp": "ここから動かないで、アルフィナ", "ko": "여기서 움직이지 마, 알피나."}
]
