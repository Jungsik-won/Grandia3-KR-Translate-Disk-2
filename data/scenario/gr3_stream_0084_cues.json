    "ko": "네?"
  },
  {
    "start": 8.15,
    "end": 8.75,
    "speaker": "유키",
    "jp": "はい！",
    "ko": "네!"
  },
  {
    "start": 23.85,
    "end": 26.35,
    "speaker": "슈미트",
    "jp": "さっきの図面だがな。",
    "ko": "아까 그 설계도 말인데."
  },
  {
    "start": 27.25,
    "end": 29.70,
    "speaker": "슈미트",
    "jp": "発想は面白い。",
    "ko": "발상은 재미있더군."
  },
  {
    "start": 29.72,
    "end": 30.75,
    "speaker": "유키",
    "jp": "ホント？",
    "ko": "정말?"
  },
  {
    "start": 31.00,
    "end": 32.75,
    "speaker": "슈미트",
    "jp": "だが、それだけだ。",
    "ko": "하지만 그것뿐이다."
  },
  {
    "start": 33.40,
    "end": 35.25,
    "speaker": "슈미트",
    "jp": "あのまま作ったんじゃ落ちる。",
    "ko": "그대로 만들었다간 추락한다."
  },
  {
    "start": 35.40,
    "end": 37.90,
    "speaker": "슈미트",
    "jp": "機体の強度不足でな。",
    "ko": "기체의 강도가 부족해."
  },
  {
    "start": 39.00,
    "end": 39.80,
    "speaker": "유키",
    "jp": "そんな……。",
    "ko": "그럴 수가……."
  },
  {
    "start": 40.80,
    "end": 48.45,
    "speaker": "슈미트",
    "jp": "小僧、お前、十九機も落として、なぜまだ飛ぼうとする？",
    "ko": "꼬마, 열아홉 대나 추락시키고도\n왜 아직도 날려고 하지?"
  },
  {
    "start": 50.55,
    "end": 52.05,
    "speaker": "유키",
    "jp": "理由なんてない。",
    "ko": "이유 같은 건 없어."
  },
  {
    "start": 53.20,
    "end": 57.50,
    "speaker": "유키",
    "jp": "ただ俺には空が、翼が必要なんだ！",
    "ko": "그저 내겐 하늘이,\n날개가 필요할 뿐이야!"
  },
  {
    "start": 65.30,
    "end": 68.70,
    "speaker": "유키",
    "jp": "これって、もしかして、あのシュミット機のエンブレム？",
    "ko": "이거 혹시, 그 슈미트 기체의\n엠블럼이야?"
  },
  {
    "start": 77.75,
    "end": 80.60,
    "speaker": "슈미트",
    "jp": "すぐに飛べる機体は、今はこいつだけだ。",
    "ko": "지금 당장 날 수 있는 기체는\n이 녀석뿐이다."
  },
  {
    "start": 80.90,
    "end": 84.60,
    "speaker": "슈미트",
    "jp": "きっちり組んでやるから、明日にでも取りに来るがいい。",
    "ko": "제대로 조립해 둘 테니\n내일 찾으러 와라."
  },
  {
    "start": 88.45,
    "end": 89.35,
    "speaker": "유키",
    "jp": "やった！",
    "ko": "해냈다!"
  },
  {
    "start": 93.70,
    "end": 97.10,
    "speaker": "유키",
    "jp": "ありがとう、シュミット！ 大事にするよ！",
    "ko": "고마워, 슈미트!\n정말 소중히 할게!"
  },
  {
    "start": 98.10,
    "end": 99.60,
    "speaker": "알피나",
    "jp": "おめでとう、ユウキ！",
    "ko": "축하해, 유키!"
  },
  {
    "start": 100.40,
    "end": 101.85,
    "speaker": "유키",
    "jp": "やったぜ、アルフィナ！",
    "ko": "해냈어, 알피나!"
  }
]
