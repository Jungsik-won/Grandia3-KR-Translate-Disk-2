[
  {"start": 6.500, "end": 8.900, "speaker": "유키", "jp": "あれ？ 俺の機体がない！", "ko": "어라? 내 비행기가 없어!"},
  {"start": 16.200, "end": 18.400, "speaker": "유키", "jp": "確か、ここに……。", "ko": "분명 여기에 있었는데……."},
  {"start": 19.500, "end": 22.900, "speaker": "울", "jp": "いいじゃん！ どうせ新しいのもらえんだし！", "ko": "괜찮잖아!\n어차피 새 비행기를 받을 거고!"},
  {"start": 23.100, "end": 27.100, "speaker": "유키", "jp": "そんなわけにいくかよ！ 作ってくれたシュミットに顔向けできないだろ？", "ko": "그럴 수는 없지! 만들어 준 슈미트에게\n면목이 없잖아!"},
  {"start": 27.350, "end": 29.000, "speaker": "울", "jp": "気にしすぎだっての！", "ko": "너무 신경 쓰는 거라니까!"},
  {"start": 29.000, "end": 33.200, "speaker": "유키", "jp": "お前！ 飛行王シュミットがどれだけすごい人かわかってて……。", "ko": "너 말이야! 비행왕 슈미트가\n얼마나 대단한 사람인지 알면서……!"},
  {"start": 33.250, "end": 34.450, "speaker": "슈미트", "jp": "おい！", "ko": "이봐!"},
  {"start": 34.600, "end": 35.300, "speaker": "유키·울", "jp": "うわっ！", "ko": "으악!"},
  {"start": 36.400, "end": 39.800, "speaker": "유키", "jp": "シュミット、すまない！ 俺にはまだ腕が足りなかった！", "ko": "슈미트, 미안해!\n내 실력이 아직 부족했어!"},
  {"start": 40.000, "end": 42.300, "speaker": "유키", "jp": "もっとうまく飛ばせれば、なんとかなったのに。", "ko": "내가 좀 더 잘 날았다면\n어떻게든 해냈을 텐데……."},
  {"start": 42.300, "end": 44.200, "speaker": "울", "jp": "シュミット、これ！", "ko": "슈미트, 이거!"},
  {"start": 45.300, "end": 45.900, "speaker": "슈미트", "jp": "うむ。", "ko": "음."},
  {"start": 51.500, "end": 53.300, "speaker": "슈미트", "jp": "ガレージの前で待っておれ。", "ko": "차고 앞에서 기다려라."},
  {"start": 53.300, "end": 54.800, "speaker": "유키", "jp": "シュミット！", "ko": "슈미트!"},
  {"start": 54.800, "end": 55.200, "speaker": "슈미트", "jp": "ああ。", "ko": "……그래."},
  {"start": 58.000, "end": 60.800, "speaker": "유키", "jp": "シュミット……ごめん。俺……。", "ko": "슈미트…… 미안해. 난……."},
  {"start": 61.400, "end": 63.900, "speaker": "슈미트", "jp": "すべて、機体が語ってくれたわ。", "ko": "모든 건 비행기가 말해 줬다."}
