      "jp_text": "<CTRL:13 FF 0F>ピューイ！<G0001>",
      "kr_text": "<CTRL:13 FF 0F>퓨이!"
    },
    {
      "id": "NPC_D1_00180500_R00740000_O81_0003",
      "source_file": "DATA/00180500.MDZ",
